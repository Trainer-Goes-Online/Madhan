# Copy to .env.local and fill in. Values are baked in at build time, so rebuild/redeploy after changing them.

# Public site URL (no trailing slash), used for absolute metadata URLs
NEXT_PUBLIC_SITE_URL=https://havocmadhan.com

# Meta (Facebook) Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=

# Webhook that receives every popup form submission: contact details + UTMs, click IDs (fbclid etc.),
# fbp/fbc and hashed Meta CAPI user data. (Make / Zapier / n8n / CRM / CAPI server)
NEXT_PUBLIC_WEBHOOK_URL=

# GHL calendar widget link shown on /call-bookingpage (Calendars > Share > Permanent link)
# e.g. https://api.leadconnectorhq.com/widget/booking/Xcv46tGXDlWb2Rw4NlOL
# Left empty, the current "Discovery Call" calendar is used.
NEXT_PUBLIC_GHL_CALENDAR_URL=

# Set to "false" to skip the public IP lookup (api64.ipify.org) used to enrich webhook payloads
NEXT_PUBLIC_FETCH_CLIENT_IP=true
